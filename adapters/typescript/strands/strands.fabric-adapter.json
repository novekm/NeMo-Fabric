{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.strands",
  "adapter_kind": "process",
  "runner": {
    "command": "node",
    "script": "dist/cli.js"
  },
  "requirements": {
    "binaries": [
      "node",
      "strands"
    ]
  },
  "config": {
    "accepts": [
      "models",
      "mcp",
      "instructions.system",
      "skills",
      "models.base_url",
      "tools.enabled",
      "tools.blocked",
      "runtime.max_turns"
    ],
    "system_instruction_modes": [
      "append"
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "builtin_tools": {
        "type": "array",
        "items": {
          "enum": [
            "shell",
            "read",
            "write",
            "edit",
            "web_fetch"
          ]
        },
        "uniqueItems": true
      },
      "max_invocations": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "default": 100
      },
      "insecure_http_model_hosts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "cedar_policy": {
        "type": "string",
        "minLength": 1
      },
      "nemo_guardrails": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "agent_name": {
            "type": "string"
          },
          "agent_digest": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "trace_file": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "model_schema": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "provider": {
            "const": "bedrock"
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "provider": {
            "enum": [
              "openai",
              "nvidia"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "base_url": {
            "type": "string",
            "minLength": 1
          },
          "api_key_env": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "required": [
          "provider",
          "model",
          "base_url"
        ],
        "additionalProperties": false
      }
    ]
  },
  "extension_schemas": {
    "agent_config": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "nemo_fabric.tools.v1": {
          "type": "object",
          "properties": {
            "builtin": {
              "type": "array",
              "items": {
                "enum": [
                  "read_file",
                  "write_file",
                  "edit_file",
                  "shell",
                  "web_fetch",
                  "web_search"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "builtin"
          ],
          "additionalProperties": false
        },
        "nemo_fabric.agents.v1": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "instructions": {
                "type": "string",
                "minLength": 1
              },
              "tools": {
                "type": "array",
                "items": {
                  "enum": [
                    "read_file",
                    "write_file",
                    "edit_file",
                    "shell",
                    "web_fetch",
                    "web_search"
                  ]
                },
                "uniqueItems": true
              },
              "model": {
                "type": "object",
                "properties": {
                  "provider": {
                    "const": "bedrock"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "provider",
                  "model"
                ],
                "additionalProperties": false
              },
              "mcp": {
                "type": "object",
                "properties": {
                  "servers": {
                    "type": "object"
                  }
                },
                "required": [
                  "servers"
                ],
                "additionalProperties": false
              },
              "skills": {
                "type": "object",
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "paths"
                ],
                "additionalProperties": false
              },
              "plugins": {
                "type": "object",
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "paths"
                ],
                "additionalProperties": false
              },
              "max_turns": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "description",
              "instructions"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "run_error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "owner": {
          "const": "adapter"
        },
        "deadline_millis": {
          "type": "integer",
          "minimum": 0
        },
        "cause_code": {
          "const": "strands_deadline_exceeded"
        }
      },
      "required": [
        "owner",
        "deadline_millis",
        "cause_code"
      ],
      "additionalProperties": false
    },
    "run_result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "stop_reason": {
          "type": "string",
          "enum": [
            "end_turn",
            "max_tokens",
            "max_turn_requests",
            "refusal",
            "cancelled"
          ]
        }
      },
      "required": [
        "session_id",
        "stop_reason"
      ],
      "additionalProperties": false
    },
    "usage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "nemo_fabric.detailed_token_usage.v1": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cache_write_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens_include_cache": {
              "type": "boolean"
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens_include_reasoning": {
              "type": "boolean"
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "capabilities": {
    "metadata": {
      "health_checks": [
        "live"
      ]
    },
    "streaming": false,
    "cancellation": false,
    "updates": false,
    "service": false
  }
}
