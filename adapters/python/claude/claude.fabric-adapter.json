{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.claude",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.claude.adapter"
  },
  "model_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "temperature": {"type": "number"},
      "api_key_env": {"type": "string", "minLength": 1},
      "base_url": {"type": "string", "minLength": 1},
      "settings": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "required": ["provider", "model"],
    "if": {
      "properties": {"provider": {"const": "anthropic"}},
      "required": ["provider"]
    },
    "else": {
      "required": ["base_url", "api_key_env"]
    },
    "additionalProperties": false
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "insecure_http_model_hosts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"
            },
            {
              "pattern": "^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$",
              "format": "ipv6"
            }
          ]
        },
        "uniqueItems": true,
        "description": "Hosts trusted for credential-free HTTP model forwarding through NeMo Relay >=0.11.0; no schemes, ports, paths, wildcards, brackets, or zone identifiers."
      },
      "setting_sources": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["user", "project", "local"]
        },
        "default": [],
        "description": "Claude settings scopes to load."
      },
      "reasoning_effort": {
        "type": "string",
        "enum": ["low", "medium", "high", "xhigh", "max"],
        "description": "Claude reasoning effort. Omit to preserve the harness default."
      },
      "max_budget_usd": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Maximum amount in US dollars that Claude may spend during one invocation."
      },
      "max_buffer_size": {
        "type": "integer",
        "minimum": 1,
        "description": "Size limit the Claude Agent SDK applies to one JSON message from Claude Code. Omit to use the SDK default."
      },
      "permission_mode": {
        "type": "string",
        "enum": [
          "default",
          "acceptEdits",
          "bypassPermissions",
          "plan",
          "dontAsk",
          "auto"
        ],
        "description": "Claude permission handling mode."
      },
      "nemo_guardrails": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "The NeMo Guardrails hooks server, such as http://127.0.0.1:8100."
          },
          "agent_name": {
            "type": "string",
            "minLength": 1,
            "description": "The agent's name in the x-nemo-agent-name header. start_agent_package sets it to the package's name."
          },
          "agent_digest": {
            "type": "string",
            "minLength": 1,
            "description": "The agent package's digest in the x-nemo-agent-digest header. start_agent_package sets it to the sha256 of the lock."
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "How long a check may take before the call is denied. Default 30."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "description": "Ask a NeMo Guardrails hooks server about every tool call, naming the run and the agent."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "extension_schemas": {
    "agent_config": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "nemo_fabric.plugins.v1": {
          "type": "object",
          "properties": {
            "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "required": ["paths"],
          "additionalProperties": false
        },
        "nemo_fabric.hooks.v1": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "format": {
                    "enum": ["https://agent-plugins.org/schemas/1.1.0/hooks.schema.json"]
                  }
                },
                "required": ["path", "format"],
                "additionalProperties": false
              }
            }
          },
          "required": ["entries"],
          "additionalProperties": false
        },
        "nemo_fabric.agents.v1": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z0-9_][a-z0-9_-]*$"},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "instructions": {"type": "string", "minLength": 1},
              "max_turns": {"type": "integer", "minimum": 1}
            },
            "required": ["description", "instructions"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "nemo_fabric.detailed_token_usage.v1": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "cached_input_tokens": {"type": "integer", "minimum": 0},
            "cache_write_input_tokens": {"type": "integer", "minimum": 0},
            "input_tokens_include_cache": {"type": "boolean"},
            "output_tokens": {"type": "integer", "minimum": 0},
            "output_tokens_include_reasoning": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "run_error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "subtype": {"type": "string"},
        "api_error_status": {"type": "integer"},
        "exit_code": {"type": "integer"},
        "timeout_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "instructions.system",
      "runtime.max_turns",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "skills"
    ],
    "system_instruction_modes": ["replace", "append"]
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": ["atif", "otel", "openinference"],
        "integration_modes": ["hooks", "gateway"]
      }
    }
  },
  "capabilities": {
    "metadata": {"health_checks": ["live", "active", "ready"]}
  }
}
