{
  "mode": "called",
  "caller": {
    "$schema": "https://nvidia.github.io/oadl/schemas/0.0.1/agent.schema.json",
    "type": "agent",
    "name": "lead",
    "description": "Hand each part of a task to the agent that fits.",
    "model": {
      "source": "ollama::llama3.2:3b"
    },
    "limits": {
      "max_turns": 30,
      "max_parallel": 2,
      "max_depth": 1,
      "max_total_tokens": 600000
    },
    "agents": {
      "coder": {
        "source": "./agents/coder",
        "variables": {
          "max_turns": 45
        }
      }
    },
    "policies": {
      "change-control": {
        "source": "oci::registry.example.com/platform/policies/licensed-assets",
        "version": "1.4.0"
      }
    }
  },
  "name": "coder",
  "document": {
    "$schema": "https://nvidia.github.io/oadl/schemas/0.0.1/agent.schema.json",
    "type": "agent",
    "name": "coder",
    "description": "Write or change code for one task.",
    "limits": {
      "max_turns": {
        "var": "max_turns"
      }
    },
    "policies": {
      "own-rules": {
        "source": "oci::registry.example.com/media-team/policies/own-rules",
        "version": "1.4.0"
      }
    },
    "variables": {
      "max_turns": {
        "type": "number",
        "minimum": 5,
        "maximum": 30,
        "default": 20
      }
    }
  },
  "expect": {
    "refused": [
      {
        "id": "variable.range:max_turns",
        "text": "variables.max_turns: the value is outside the range 5 to 30"
      }
    ]
  }
}
