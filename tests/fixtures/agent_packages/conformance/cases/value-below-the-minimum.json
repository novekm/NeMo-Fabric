{
  "mode": "start",
  "document": {
    "$schema": "https://nvidia.github.io/oadl/schemas/0.0.1/agent.schema.json",
    "type": "agent",
    "name": "reporter",
    "limits": {
      "max_turns": {
        "var": "max_turns"
      }
    },
    "variables": {
      "max_turns": {
        "type": "number",
        "minimum": 5,
        "maximum": 60,
        "default": 20
      }
    }
  },
  "values": {
    "max_turns": 4
  },
  "expect": {
    "agent": null,
    "refused": [
      {
        "id": "variable.range:max_turns",
        "text": "variables.max_turns: the value is outside the range 5 to 60"
      }
    ]
  }
}
