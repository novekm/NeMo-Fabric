{
  "mode": "definition",
  "definition": {
    "$schema": "https://oadl.example/schemas/0.4.0/agent-definition.schema.json",
    "type": "agent-definition",
    "name": "ada-launch-video",
    "agent": {
      "source": "./agent.json"
    },
    "variables": {
      "job": "Make the launch video."
    },
    "skills": {
      "brand-kit": {
        "source": "git::https://git.example.com/payments/agent-parts.git//skills/brand-kit",
        "version": "~> 1.3"
      }
    }
  },
  "agent": {
    "$schema": "https://oadl.example/schemas/0.4.0/agent.schema.json",
    "type": "agent",
    "name": "media-desk",
    "description": "The media team's agent for video work.",
    "instructions": {
      "var": "job"
    },
    "model": {
      "source": {
        "var": "model"
      }
    },
    "limits": {
      "max_turns": 40,
      "max_total_tokens": 600000
    },
    "variables": {
      "job": {
        "type": "string"
      },
      "model": {
        "type": "string",
        "default": "ollama::llama3.2:3b"
      }
    },
    "skills": {
      "review": {
        "source": "./skills/review"
      },
      "brand-kit": {
        "source": "git::https://git.example.com/media-team/agent-parts.git//skills/brand-kit",
        "version": "~> 1.3"
      }
    },
    "connectors": {
      "asset-library": {
        "source": "mcp::https://mcp.example.com/asset-library",
        "version": "2.3.0"
      }
    },
    "tools": [
      {
        "connector": "asset-library",
        "tool": "find_asset"
      }
    ]
  },
  "expect": {
    "agent": null,
    "refused": [
      {
        "id": "definition.name_in_use:skills.brand-kit",
        "text": "skills.brand-kit: media-desk already has an entry of that name, and the two entries are not identical"
      }
    ]
  }
}
