{
  "mode": "start",
  "document": {
    "$schema": "https://oadl.example/schemas/0.4.0/agent.schema.json",
    "type": "agent",
    "name": "reporter",
    "instructions": {
      "var": "job"
    },
    "model": {
      "source": {
        "var": "model"
      }
    },
    "limits": {
      "max_turns": {
        "var": "max_turns"
      }
    },
    "variables": {
      "job": {
        "type": "string"
      },
      "model": {
        "type": "string",
        "default": "ollama::llama3.2:3b"
      },
      "max_turns": {
        "type": "number",
        "default": 20,
        "description": "Most model turns one run may take."
      }
    }
  },
  "values": {
    "job": "Summarize the week.",
    "max_turns": "many"
  }
}
